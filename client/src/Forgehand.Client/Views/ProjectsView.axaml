<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Forgehand.Client.Core.ViewModels;assembly=Forgehand.Client.Core"
             x:Class="Forgehand.Client.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

  <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,*">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Authorized projects" Classes="heading" />
        <TextBlock Classes="muted"
                   Text="Only the projects that the daemon authorizes for your account are listed." />
      </StackPanel>
      <Button Grid.Column="1"
              Content="Refresh"
              VerticalAlignment="Top"
              Command="{Binding RefreshCommand}" />
    </Grid>

    <Border Grid.Row="1" Classes="error" Margin="0,16,0,0" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
    </Border>

    <TextBlock Grid.Row="2"
               Margin="0,16,0,0"
               Classes="muted"
               Text="Loading projects…"
               IsVisible="{Binding IsLoading}" />

    <Border Grid.Row="2" Classes="card" Padding="20" Margin="0,16,0,0"
            IsVisible="{Binding ShowEmptyState}">
      <StackPanel Spacing="6">
        <TextBlock Text="No projects are authorized for this account." Classes="title" />
        <TextBlock Classes="muted"
                   Text="Ask a Forgehand administrator to grant this account access to a project, then refresh." />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="3" Margin="0,16,0,0" IsVisible="{Binding ShowProjects}">
      <ItemsControl ItemsSource="{Binding Projects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectItem">
            <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding Name}"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding IdText}"
                           Classes="muted small" />
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,6,0,0"
                           Text="{Binding RootPath}"
                           Classes="mono"
                           IsVisible="{Binding HasRootPath}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
